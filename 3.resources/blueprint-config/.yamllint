# yamllint configuration for DAP blueprints (constitution §5.2).
# Copy to the blueprint project root, then run:  yamllint .
---
extends: default

ignore: |
  # Helm templates contain Go template syntax and are checked by `helm lint`
  helm/*/templates/
  # Generated and vendored content
  .venv/
  node_modules/

rules:
  # Blueprint descriptions and jmespath expressions run long
  line-length:
    max: 120
    level: warning
  # Split blueprint files do not start with ---
  document-start: disable
  # TOSCA uses true/false; keys such as `on` are not booleans here
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  # Intrinsic functions are written { get_input: name } and [ a, b ]
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  # Git may check files out with CRLF on Windows
  new-lines: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
  comments:
    min-spaces-from-content: 1
