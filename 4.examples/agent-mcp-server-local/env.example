# Agent MCP Server (local) - environment configuration
# Copy to .env and fill in values:  cp env.example .env
# .env is git-ignored - never commit real credentials.

# ── Required: server refuses to start without these ──────────────────────────

# DAP service-account (predefined client) used for delegated token exchange
DAP_PREDEFINED_CLIENT_ID=<service-account-client-id>
DAP_PREDEFINED_CLIENT_SECRET=<service-account-client-secret>

# Portal domain is pinned here (never read from request headers).
# Must be the portal that issued the service account above AND the customer tokens.
DAP_PORTAL_DOMAIN=dsp-portal.automation.dell.com
# Lab environment: DAP_PORTAL_DOMAIN=<portal-domain>

# Orchestrator allowlist (SSRF guard) - comma-separated hostnames or wildcards.
# Every x-dap-orchestrator-domain a client sends must match, or it gets INVALID_DOMAIN.
# For a lab orchestrator, append its domain, e.g. *.automation.dell.com,*.<lab-domain>
DAP_ALLOWED_ORCHESTRATOR_DOMAINS=*.automation.dell.com

# AWS region for Bedrock (required even in air-gapped mode)
AWS_REGION=us-east-1

# ── LLM backend: connected mode (AWS Bedrock) ────────────────────────────────
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# AWS_SESSION_TOKEN=<aws-session-token>
# BEDROCK_MODEL_NAME=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── LLM backend: air-gapped mode (local LLM endpoint) ────────────────────────
# Uncomment to use a local OpenAI-compatible endpoint (e.g. Ollama) instead of Bedrock.
# In air-gapped mode the endpoint must be loopback or a private IP.
# BPA_DEPLOYMENT_MODE=air-gapped
# LLM_ENDPOINT_URL=http://192.168.1.100:11434/v1
# LLM_ENDPOINT_PROVIDER=openai
# LLM_MODEL=llama3.1
# LLM_CREDENTIAL=

# ── Local dev conveniences ───────────────────────────────────────────────────
# Entitlement check: enforce (default) | dry-run | skip (local dev only)
ENTITLEMENT_MODE=dry-run
# Disable analytics event shipping for local runs
BPA_ANALYTICS_ENABLED=false
# Lab environments with self-signed certs: trust the lab CA.
# Requires the ./certs volume in compose.yaml. Do NOT use NODE_TLS_REJECT_UNAUTHORIZED=0.
# NODE_EXTRA_CA_CERTS=/certs/lab-ca.pem
# Advertise the local URL in GET /docs and auth error hints
DAP_DOCS_URL=http://localhost:3000/docs
LOG_LEVEL=info
